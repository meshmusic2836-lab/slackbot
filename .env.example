# ── SPYRO V1 Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.

# Neon Postgres connection string
# Get yours at https://neon.tech → create project → copy connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Gmail SMTP for password reset emails
# Get an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Your deployed app URL (for password reset links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ── Optional integrations ─────────────────────────────────────────────

# Upstash Redis (for Telegram bot history persistence)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Langfuse observability (LLM tracing)
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
